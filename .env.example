# LVN'LARGE — private keys for local development.
# This file is ignored by Git (.gitignore rule ".env*") and must NEVER be committed or shared.
# Paste each value directly after the "=" sign. No quotes, no spaces.

# ─── SUPABASE ───────────────────────────────────────────────
# Supabase dashboard → your project → "Connect" button (top bar) → copy the Project URL.
# Looks like: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Project Settings → API Keys → "Publishable key".
# Starts with sb_publishable_   (safe to be seen by browsers)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase dashboard → Project Settings → API Keys → "Secret keys" → reveal and copy.
# Starts with sb_secret_   (SECRET — full database access, server only)
SUPABASE_SECRET_KEY=

# ─── PAYSTACK (TEST MODE ONLY) ──────────────────────────────
# Paystack dashboard → make sure the "Test Mode" toggle is ON →
# Settings → API Keys & Webhooks → Test Public Key.
# Starts with pk_test_   (safe to be seen by browsers)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Same page → Test Secret Key.
# Starts with sk_test_   (SECRET — server only; also used to verify webhooks)
PAYSTACK_SECRET_KEY=
